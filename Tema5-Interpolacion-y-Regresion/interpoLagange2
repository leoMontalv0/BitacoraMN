# Ejercicio: Estimar la temperatura a las 2.5 horas
# Datos medidos en un experimento:
# Hora 1 -> 20°C, Hora 3 -> 28°C, Hora 5 -> 40°C

x = [1, 3, 5]      # tiempos (horas)
y = [20, 28, 40]   # temperaturas (°C)

xp = 2.5           # hora a estimar
n = len(x)
yp = 0

for i in range(n):
    p = y[i]

    for j in range(n):
        if i != j:
            p = p * (xp - x[j]) / (x[i] - x[j])

    yp = yp + p

print("Temperatura aproximada:", round(yp, 4), "°C")